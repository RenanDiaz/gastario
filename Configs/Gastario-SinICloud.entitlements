<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Para equipos personales (cuenta gratis), que no admiten iCloud: sin respaldo
	     automático; "Exportar ahora" sigue ofreciendo el CSV para compartir. -->
