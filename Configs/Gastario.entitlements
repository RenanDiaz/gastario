<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Store de SwiftData compartido con los intents (INTENT.md, Persistencia). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.renandiaz.Gastario</string>
	</array>
	<!-- iCloud Documents para el auto-export (SPEC Fase 5). No es CloudKit. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.renandiaz.Gastario</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.renandiaz.Gastario</string>
	</array>
</dict>
</plist>
